[
  {
    "name": "theme_info",
    "theme_name": "Selvedge",
    "theme_version": "1.0.0",
    "theme_author": "SEO Master Team",
    "theme_documentation_url": "https://seomasterteam.com/selvedge/docs",
    "theme_support_url": "https://seomasterteam.com/selvedge/support"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Selvedge"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 110
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Replaces the background color when used."
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Surface (image backgrounds, panels, inputs)",
            "default": "#F1EFEC"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#191817"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent (sale prices, wishlist, highlights)",
            "default": "#7B1E2D"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Solid button background",
            "default": "#191817"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Solid button label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Outline button",
            "default": "#191817"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Font",
        "default": "tenor_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Size scale",
        "min": 80,
        "max": 140,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "label": "Letter spacing",
        "min": -6,
        "max": 2,
        "step": 1,
        "unit": "%",
        "default": -2
      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "Letter case",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "Default"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ]
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Font",
        "default": "manrope_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Size scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Editorial accent"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "label": "Editorial accent font",
        "default": "instrument_serif_i4"
      },
      {
        "type": "paragraph",
        "content": "Used for look numbers, pull quotes and editorial captions."
      },
      {
        "type": "select",
        "id": "nav_case",
        "label": "Menu and label letter case",
        "default": "uppercase",
        "options": [
          {
            "value": "none",
            "label": "Default"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ]
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1100,
        "max": 1800,
        "step": 100,
        "unit": "px",
        "default": 1680
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Space between sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "Grid spacing",
        "min": 8,
        "max": 40,
        "step": 4,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "radius_large",
        "label": "Corner radius of images and panels",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "radius_small",
        "label": "Corner radius of small elements",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 2
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "select",
        "id": "header_style",
        "label": "Layout",
        "default": "center",
        "options": [
          {
            "value": "center",
            "label": "Logo centered"
          },
          {
            "value": "left",
            "label": "Logo left"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "header_transparent",
        "label": "Transparent over the first section on the home page",
        "default": false,
        "info": "Works best with a full-screen image banner."
      },
      {
        "type": "checkbox",
        "id": "header_search_shortcut",
        "label": "Open search with \u2318K / Ctrl+K",
        "default": true
      }
    ]
  },
  {
    "name": "Buttons & inputs",
    "settings": [
      {
        "type": "range",
        "id": "buttons_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 2
      },
      {
        "type": "range",
        "id": "inputs_radius",
        "label": "Input corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "buttons_uppercase",
        "label": "Uppercase button text",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "buttons_magnetic",
        "label": "Magnetic hover on primary buttons",
        "default": false,
        "info": "Buttons gently follow the pointer on desktop."
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "wishlist",
        "label": "Enable wishlist",
        "default": true,
        "info": "Adds a heart to product cards and pages. The list is saved in the shopper's browser."
      },
      {
        "type": "select",
        "id": "card_style",
        "label": "Style",
        "default": "editorial",
        "options": [
          {
            "value": "editorial",
            "label": "Editorial (image, text below)"
          },
          {
            "value": "boxed",
            "label": "Image on surface color"
          },
          {
            "value": "minimal",
            "label": "Minimal, details on hover"
          }
        ]
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "default": "portrait",
        "options": [
          {
            "value": "portrait",
            "label": "Portrait 3:4"
          },
          {
            "value": "tall",
            "label": "Tall 2:3"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "adapt",
            "label": "Adapt to image"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_type",
        "label": "Show product type",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show quick add sizes on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_view",
        "label": "Enable quick view",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show colour swatches (hover to preview)",
        "default": true
      },
      {
        "type": "header",
        "content": "Badges"
      },
      {
        "type": "text",
        "id": "badge_new_tag",
        "label": "Product tag for 'New' badge",
        "default": "new"
      },
      {
        "type": "text",
        "id": "badge_hot_tag",
        "label": "Product tag for 'Last pieces' badge",
        "default": "last-pieces"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "After adding to cart",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Open cart drawer"
          },
          {
            "value": "notification",
            "label": "Show a small notice"
          },
          {
            "value": "page",
            "label": "Go to cart page"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Enable cart note",
        "default": true
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "Number in your store currency, e.g. 999. Leave blank to hide the progress bar."
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Cart drawer recommendations"
      }
    ]
  },
  {
    "name": "Demo content",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_demo_fallbacks",
        "label": "Show demo content when store data is empty",
        "default": true,
        "info": "Keeps the storefront visually complete until products, collections, and other content are added."
      }
    ]
  },
  {
    "name": "Interactions",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Reveal content on scroll",
        "default": true,
        "info": "Images fade in as they enter the screen."
      },
      {
        "type": "checkbox",
        "id": "animations_text",
        "label": "Reveal large headings line by line",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_transitions",
        "label": "Smooth page transitions",
        "default": true,
        "info": "Uses the browser View Transitions API where supported."
      },
      {
        "type": "checkbox",
        "id": "custom_cursor",
        "label": "Custom cursor on desktop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "grain",
        "label": "Film grain texture",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "animations_hover",
        "label": "Image zoom on hover",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "placeholder": "https://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "placeholder": "https://tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "placeholder": "https://facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "placeholder": "https://youtube.com/shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X / Twitter",
        "placeholder": "https://x.com/shopify"
      }
    ]
  }
]
