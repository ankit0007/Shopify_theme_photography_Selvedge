{% doc %}
  Renders a themed empty state with an optional safe link.
  @param {string} title - Empty state heading
  @param {string} text - Empty state description
  @param {string} [link_label] - Optional link label
  @param {string} [link_url] - Optional link destination
{% enddoc %}
<div class="empty-state">
  <h2 class="h3">{{ title | escape }}</h2>
  {%- if text != blank -%}<p>{{ text | escape }}</p>{%- endif -%}
  {%- if link_label != blank and link_url != blank -%}
    <a href="{{ link_url }}" class="button button--secondary">{{ link_label | escape }}</a>
  {%- endif -%}
</div>
