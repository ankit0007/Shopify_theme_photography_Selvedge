{%- liquid
  assign networks = 'facebook,instagram,youtube,tiktok,twitter,pinterest' | split: ','
-%}
<ul class="social-icons" role="list">
  {%- for network in networks -%}
    {%- assign key = 'social_' | append: network | append: '_link' -%}
    {%- if settings[key] != blank -%}
      <li>
        <a href="{{ settings[key] }}" target="_blank" rel="noopener">
          {% render 'icon', name: network %}
          <span class="visually-hidden">{{ network | capitalize }}</span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
