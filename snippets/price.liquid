{%- comment -%}
  Usage: {% render 'price', product: product, use_variant: true, size: 'large' %}
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign money_price = price | money
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}{% if size == 'large' %} price--large{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
  {%- else -%}
    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
  {%- endif -%}
  <span class="price__current">
    {%- if use_variant == false and product.price_varies -%}
      {{ 'products.product.price.from_price_html' | t: price: money_price }}
    {%- else -%}
      {{ money_price }}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_at_price | money }}</s>
  {%- endif -%}
  {%- if use_variant and target.unit_price_measurement -%}
    <span class="unit-price">
      {{ target.unit_price | money }}/
      {%- if target.unit_price_measurement.reference_value != 1 -%}{{ target.unit_price_measurement.reference_value }}{%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
