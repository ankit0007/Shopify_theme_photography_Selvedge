<div class="rail-footer">
  <div class="rail-progress" aria-hidden="true"><span></span></div>
  <div class="rail-nav">
    <button type="button" class="icon-btn" data-rail-prev aria-label="{{ 'general.slider.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
    <button type="button" class="icon-btn" data-rail-next aria-label="{{ 'general.slider.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
  </div>
</div>
