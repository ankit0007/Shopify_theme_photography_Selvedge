{%- if settings.free_shipping_threshold != blank -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100 | round
  -%}
  {%- if threshold > 0 -%}
    <div class="free-shipping">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_unlocked' | t }}
      {%- endif -%}
      <div class="free-shipping__bar" aria-hidden="true"><span style="width: {{ pct }}%"></span></div>
    </div>
  {%- endif -%}
{%- endif -%}
