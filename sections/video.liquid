{% render 'section-spacing' %}
<div class="color-{{ section.settings.color_scheme }} section-bg section-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="intro intro--center reveal"><h2>{{ section.settings.title | escape }}</h2></div>
    {%- endif -%}
    <div class="video-section media media--wide reveal">
      {%- if section.settings.video != blank -%}
        <button type="button" class="video-section__poster" data-video-poster aria-label="{{ 'sections.video.play' | t }}">
          {%- if section.settings.cover != blank -%}
            {{ section.settings.cover | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '600, 1000, 1500, 2000', sizes: '100vw', alt: section.settings.cover.alt }}
          {%- else -%}
            {{ section.settings.video.preview_image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', alt: '' }}
          {%- endif -%}
          <span class="video-section__play">{% render 'icon', name: 'play' %}</span>
        </button>
        <template>{{ section.settings.video | video_tag: autoplay: true, controls: true, playsinline: true, image_size: '1600x' }}</template>
      {%- elsif section.settings.video_url != blank -%}
        <button type="button" class="video-section__poster" data-video-poster aria-label="{{ 'sections.video.play' | t }}">
          {%- if section.settings.cover != blank -%}
            {{ section.settings.cover | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', alt: section.settings.cover.alt }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="video-section__play">{% render 'icon', name: 'play' %}</span>
        </button>
        <template>
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0" title="{{ section.settings.title | escape }}" allow="autoplay; encrypted-media" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" title="{{ section.settings.title | escape }}" allow="autoplay; fullscreen" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
          {%- endif -%}
        </template>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        <span class="video-section__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "See it in action" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover", "label": "Cover image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [ { "name": "Video" } ]
}
{% endschema %}
