<div class="page-width">
  <div class="account-box">
    <h1>{{ 'customer.activate_account.title' | t }}</h1>
    <p class="text-center caption">{{ 'customer.activate_account.subtext' | t }}</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label><input type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ActivateConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label><input type="password" id="ActivateConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="button button--full">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="button button--link button--full" style="margin-top:1.6rem;">{{ 'customer.activate_account.cancel' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Activate account", "tag": "section", "class": "section", "settings": [] }
{% endschema %}
