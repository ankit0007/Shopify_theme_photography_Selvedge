<div class="page-width" style="padding-bottom: 8rem;">
  <div class="page-header"><h1>{{ blog.title | escape }}</h1></div>
  {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
    <div class="blog-tags">
      <a href="{{ blog.url }}" class="pill"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'blogs.all' | t }}</a>
      {%- for tag in blog.all_tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="pill"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag | escape }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- paginate blog.articles by 9 -%}
    {%- if blog.articles_count > 0 -%}
      <ul class="grid" role="list" style="--cols: 3; --cols-tablet: 2; --cols-mobile: 1; row-gap: 5.6rem;">
        {%- for article in blog.articles -%}
          <li>{% render 'article-card', article: article, index: forloop.index0 %}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate, anchor: '' %}
    {%- else -%}
      {% render 'empty-state',
        title: section.settings.empty_title,
        text: section.settings.empty_text,
        link_label: section.settings.empty_button_label,
        link_url: section.settings.empty_button_link | default: routes.root_url
      %}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_tags", "label": "Show tag filter", "default": true },
    { "type": "header", "content": "Empty blog" },
    { "type": "text", "id": "empty_title", "label": "Empty heading", "default": "Stories are being developed" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Notes on cloth, craft and the people behind each edit will appear here." },
    { "type": "text", "id": "empty_button_label", "label": "Empty button label", "default": "Return to the store" },
    { "type": "url", "id": "empty_button_link", "label": "Empty button link", "info": "Leave blank to link to the home page." }
  ]
}
{% endschema %}
