<div class="password-page color-{{ section.settings.color_scheme }} section-bg">
  <div class="password-page__inner">
    <p class="h2">{{ shop.name }}</p>
    {%- if shop.password_message != blank -%}
      <h1 class="h1">{{ shop.password_message }}</h1>
    {%- else -%}
      <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    <p>{{ section.settings.text | escape }}</p>

    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
      <div class="inline-form">
        <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
        <input type="email" id="PasswordNewsletter" name="contact[email]" class="input" placeholder="{{ 'newsletter.label' | t }}" required>
        <button type="submit" class="button">{{ 'newsletter.button_label' | t }}</button>
      </div>
    {%- endform -%}

    <details style="margin-top: 4.8rem;">
      <summary class="button button--link" style="list-style:none;">{{ 'password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', style: 'margin-top:2rem;' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="inline-form">
          <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input type="password" id="StorePassword" name="password" class="input" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
          <button type="submit" class="button">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="caption" style="margin-top:2rem;">{{ 'password.admin_link_html' | t }}</p>
    </details>
    <p class="caption" style="margin-top: 4rem;">{{ powered_by_link }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "text", "id": "text", "label": "Text", "default": "Be the first to know when we launch." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
