{% render 'section-spacing' %}
<div class="color-{{ section.settings.color_scheme }} section-bg section-padding">
  <div class="page-width faq-layout">
    <div class="faq-layout__intro">
      <h2 data-split-lines>{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead reveal">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.root_url }}" class="button button--secondary reveal">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
    <div class="reveal">
      {%- for block in section.blocks -%}
        <details class="accordion" {% if section.settings.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'plus' %}</summary>
          <div class="accordion__content rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Good to know" },
    { "type": "text", "id": "text", "label": "Text", "default": "Can't find your answer? Our team replies within a working day." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_first", "label": "Open first row", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [ { "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "heading", "label": "Question", "default": "When will my order ship?" },
    { "type": "richtext", "id": "content", "label": "Answer", "default": "<p>Orders placed before 2pm on a working day leave our studio the same day.</p>" },
    { "type": "page", "id": "page", "label": "Answer from page" }
  ] } ],
  "presets": [ { "name": "FAQ", "blocks": [
    { "type": "row" },
    { "type": "row", "settings": { "heading": "Can I return something I used once?", "content": "<p>Yes, within 15 days, as long as it is clean and undamaged.</p>" } },
    { "type": "row", "settings": { "heading": "Do you deliver outside India?", "content": "<p>We ship to 30 countries. Duties are shown before you pay.</p>" } }
  ] } ]
}
{% endschema %}
