<div class="page-width error-page">
  <p class="h0">404</p>
  <h1 class="h2">{{ 'templates.404.title' | t }}</h1>
  <p class="caption">{{ 'templates.404.subtext' | t }}</p>
  <div class="button-group" style="justify-content:center;margin-top:2.4rem;">
    <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
    <a href="{{ routes.root_url }}" class="button button--secondary">{{ 'general.home' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
