{% render 'section-spacing' %}
<div class="color-{{ section.settings.color_scheme }} section-bg section-padding" style="overflow:hidden;"{% unless recommendations.performed? and recommendations.products_count > 0 %} hidden{% endunless %}>
  <div class="page-width" data-rail-scope data-recommendations="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=complementary">
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      {% render 'intro', title: section.settings.heading %}
      <ul class="rail" role="list" data-rail data-cursor="{{ 'general.cursor.drag' | t }}" style="--per: 4;">
        {%- for recommendation in recommendations.products limit: section.settings.products_to_show -%}
          <li>{% render 'product-card', card_product: recommendation, section_id: section.id %}</li>
        {%- endfor -%}
      </ul>
      {% render 'rail-footer' %}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Complementary products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Pair it with" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "label": "Maximum products to show", "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [
    { "name": "Complementary products" }
  ]
}
{% endschema %}
