{%- if section.blocks.size > 0 or request.design_mode -%}
{% render 'section-spacing' %}
<div class="color-{{ section.settings.color_scheme }} section-bg section-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="intro intro--center reveal"><h2 data-split-lines>{{ section.settings.title | escape }}</h2></div>
    {%- endif -%}
    <ul class="grid" data-stagger role="list" style="--cols: {{ section.settings.columns }}; --cols-tablet: 2; --cols-mobile: {{ section.settings.columns_mobile }};">
      {%- for block in section.blocks -%}
        <li class="multicolumn__item multicolumn__item--{{ section.settings.alignment }}{% if section.settings.boxed %} multicolumn__item--boxed{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media media--square" style="border-radius: var(--radius-card); width: 100%;">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.image.alt }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="multicolumn__icon">{% render 'icon', name: block.settings.icon %}</span>
          {%- else -%}
            <div class="media media--square" style="border-radius: var(--radius-card); width: 100%;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Why customers love us" },
    { "type": "range", "id": "columns", "min": 1, "max": 6, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 2, "step": 1, "label": "Columns on mobile", "default": 2 },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "checkbox", "id": "boxed", "label": "Show background box", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    { "type": "column", "name": "Column", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck",
        "options": [
          { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" },
          { "value": "lock", "label": "Lock" }, { "value": "leaf", "label": "Leaf" }, { "value": "sparkle", "label": "Sparkle" },
          { "value": "shield", "label": "Shield" }, { "value": "chat", "label": "Chat" }, { "value": "heart", "label": "Heart" },
          { "value": "bolt", "label": "Bolt" }, { "value": "gift", "label": "Gift" }, { "value": "star", "label": "Star" }
        ] },
      { "type": "image_picker", "id": "image", "label": "Image (replaces icon)" },
      { "type": "text", "id": "title", "label": "Heading", "default": "Free shipping" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>On all orders above a minimum value.</p>" }
    ] }
  ],
  "presets": [
    { "name": "Multicolumn", "blocks": [
      { "type": "column", "settings": { "icon": "truck", "title": "Free shipping", "text": "<p>Fast, free delivery on orders above the minimum value.</p>" } },
      { "type": "column", "settings": { "icon": "return", "title": "Easy returns", "text": "<p>Changed your mind? Return within 15 days, no questions asked.</p>" } },
      { "type": "column", "settings": { "icon": "lock", "title": "Secure checkout", "text": "<p>Your payment details are encrypted and protected.</p>" } },
      { "type": "column", "settings": { "icon": "chat", "title": "Real support", "text": "<p>Talk to a real person, seven days a week.</p>" } }
    ] }
  ]
}
{% endschema %}
