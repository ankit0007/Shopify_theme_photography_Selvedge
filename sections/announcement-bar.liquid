{%- if section.blocks.size > 0 or request.design_mode -%}
<div class="announcement color-{{ section.settings.color_scheme }}" role="region" aria-label="{{ 'sections.announcement.label' | t }}" data-announcement data-speed="{{ section.settings.speed }}" {{ section.shopify_attributes }}>
  <div class="announcement__inner">
    {%- for block in section.blocks -%}
      <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {{ block.settings.text | escape }}
        {%- if block.settings.link != blank and block.settings.link_label != blank -%}
          &nbsp;<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 5,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "range", "id": "speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Rotate every", "default": 5 }
  ],
  "blocks": [
    { "type": "announcement", "name": "Announcement", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free delivery over ₹999 across India." },
      { "type": "text", "id": "link_label", "label": "Link label" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Announcement bar", "blocks": [ { "type": "announcement" } ] } ]
}
{% endschema %}
