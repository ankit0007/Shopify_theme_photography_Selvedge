{% layout none %}
{%- liquid
  assign initial_money = gift_card.initial_value | money
  assign balance_money = gift_card.balance | money
  assign expires = gift_card.expires_on | date: '%d %b %Y'
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_money, shop: settings.brand_name | default: 'Selvedge' }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="color-{{ settings.color_schemes.first.id }}">
    <main class="gift-card">
      <p class="h3">{{ settings.brand_name | default: 'Selvedge' }}</p>
      <h1>{{ 'gift_cards.issued.subtext' | t }}</h1>
      <p class="h2">{{ gift_card.initial_value | money }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p>{{ 'gift_cards.issued.remaining_html' | t: balance: balance_money }}</p>
      {%- endif -%}
      {%- if gift_card.expired -%}
        <p class="badge badge--sold">{{ 'gift_cards.issued.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        <p class="caption">{{ 'gift_cards.issued.expires_on' | t: expires_on: expires }}</p>
      {%- endif -%}
      <div class="gift-card__code">{{ gift_card.code | format_code }}</div>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display:flex;justify-content:center;margin-bottom:2.4rem;"></div>
      <div class="button-group" style="justify-content:center;">
        <a href="{{ shop.url }}" class="button" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
      {%- if gift_card.pass_url -%}
        <p style="margin-top:2.4rem;"><a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy" style="margin:0 auto;"></a></p>
      {%- endif -%}
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
